# Local practice requires no environment variables and no wallet.
HOST=127.0.0.1
PORT=3001

# Testnet roles are generated in Windows encrypted, ignored runtime storage.
# Never put deployer or settlement keys in VITE variables or source.
# See docs/TESTNET.md. No testnet gas purchase or mainnet fallback is authorized.
BLOCKVECTRA_API_KEY=your_blockvectra_api_key_here